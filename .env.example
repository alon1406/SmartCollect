# Copy to .env and fill in. .env is gitignored and must never be committed.

# ---- local development (compose.yaml) ---------------------------------------
# Password for the PostgreSQL container that Spring Boot starts automatically.
POSTGRES_PASSWORD=secret

# ---- production deployment (docker-compose.prod.yml) ------------------------
# Password for the PostgreSQL container in the production stack.
# Generate one, do not reuse the development value:
#   openssl rand -base64 24
DB_PASSWORD=

# Domain the demo is served from. Its A record must already point at this
# server - Caddy uses it to request the TLS certificate.
DOMAIN=smartcollect.example.com
